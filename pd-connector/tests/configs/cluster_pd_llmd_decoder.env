# PDConnector — llmd-decoder pod, dual GPU (GPU 0 = prefiller, GPU 1 = decoder)
CONNECTOR=pd_connector
PREFILLER_POD=llmd-decoder
DECODER_POD=llmd-decoder
PROXY_POD=llmd-decoder
PREFILLER_GPUS=0
DECODER_GPUS=1

MODEL=Qwen/Qwen3-0.6B
GPU_MEM_UTIL=0.12
MAX_MODEL_LEN=512
BLOCK_SIZE=128

# PDConnector-specific
CPU_BYTES=2147483648
DECODER_FIRST=false

# llmd-decoder uses system python
VLLM_BIN=vllm
PYTHON_BIN=python3

LOG_LEVEL=INFO
HEALTH_TIMEOUT=600
